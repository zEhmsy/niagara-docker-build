# ---------------------------------------------------------------------------
# niagara-docker-build configuration.
#
# Copy this file to `niagara-build.conf` (in the repo root) or to
# ~/.config/niagara-docker-build/config and change what you need.
# Every variable can be overridden from the environment:
#   NIAGARA_DIST_DIR=/tmp/out ./scripts/nbuild.sh myModule
#
# Nothing here is mandatory: with no config at all the scripts use the defaults.
# ---------------------------------------------------------------------------

# Folder holding the Tridium installers (zip). Do NOT commit it.
# Default: <repo>/installers
#NIAGARA_INSTALLERS_DIR="$HOME/Niagara/installers"

# Version used when you do not pass one to build-image.sh and it cannot be
# derived from the project gradle.properties.
#NIAGARA_DEFAULT_VERSION="4.15.3.28"

# Image tag prefix: images are named <prefix>:<version>.
#NIAGARA_IMAGE_PREFIX="niagara-build"

# Where the signing profile lives (it will contain a `security/` dir).
# This is the folder mounted as ~/.tridium inside the container.
# Default: ~/.niagara-docker/tridium
#NIAGARA_SIGNING_HOME="$HOME/.niagara-docker/tridium"

# Where to copy the produced jars.
# Empty -> <project>/dist
# Set   -> <NIAGARA_DIST_DIR>/<project-name>/
#NIAGARA_DIST_DIR="$HOME/Niagara/artifacts"

# 1 = all jars go straight into NIAGARA_DIST_DIR, no per-project subfolder.
#NIAGARA_DIST_FLAT=0

# Container platform. Tridium installers are x86-64 only: on Apple Silicon they
# run under emulation (slower, but they work).
#NIAGARA_PLATFORM="linux/amd64"

# Globs used to find the installer inside NIAGARA_INSTALLERS_DIR.
# Change them if your zips are named differently (see README, Installers).
#NIAGARA_N5_INSTALLER_GLOB="Niagara_5_Debian-%VERSION%*.zip"
#NIAGARA_N4_INSTALLER_GLOB="*N4*Linux_x64-%VERSION%*.zip"

# Tridium brand: it shows up in the Niagara "home" paths.
# N5 uses the lowercase brand (/etc/niagara/<brand>/config/<ver>),
# N4 uses the distributor one (e.g. TridiumEMEA, Tridium, Honeywell...).
#NIAGARA_N5_BRAND="tridium"
#NIAGARA_N4_BRAND="TridiumEMEA"

# Sources for the full side-by-side JDKs (see README, "Why two JDKs").
#JDK_URL_N5="https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jdk/hotspot/normal/eclipse"
#JDK_URL_N4="https://api.adoptium.net/v3/binary/latest/8/ga/linux/x64/jdk/hotspot/normal/eclipse"

# Name of the Docker volume holding the Gradle cache (one per major version).
#NIAGARA_GRADLE_CACHE_PREFIX="niagara-gradle-cache"
