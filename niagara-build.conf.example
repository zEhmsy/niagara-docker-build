# ---------------------------------------------------------------------------
# Configurazione di niagara-docker-build.
#
# Copia questo file in `niagara-build.conf` (nella root del repo) oppure in
# ~/.config/niagara-docker-build/config e modifica quello che ti serve.
# Ogni variabile puo' essere sovrascritta da environment:
#   NIAGARA_DIST_DIR=/tmp/out ./scripts/nbuild.sh myModule
#
# Nessun valore qui e' obbligatorio: senza config gli script usano i default.
# ---------------------------------------------------------------------------

# Cartella con gli installer Tridium (zip). NON committarla.
# Default: <repo>/installers
#NIAGARA_INSTALLERS_DIR="$HOME/Niagara/installers"

# Versione usata quando non la passi a build-image.sh e non e' deducibile
# dal gradle.properties del progetto.
#NIAGARA_DEFAULT_VERSION="4.15.3.28"

# Prefisso dei tag immagine: le immagini si chiamano <prefisso>:<versione>.
#NIAGARA_IMAGE_PREFIX="niagara-build"

# Dove vive il profilo di firma (dentro ci sara' una dir `security/`).
# E' la cartella montata come ~/.tridium nel container.
# Default: ~/.niagara-docker/tridium
#NIAGARA_SIGNING_HOME="$HOME/.niagara-docker/tridium"

# Dove copiare i jar prodotti.
# Vuoto  -> <progetto>/dist
# Valorizzato -> <NIAGARA_DIST_DIR>/<nome-progetto>/
#NIAGARA_DIST_DIR="$HOME/Niagara/artifacts"

# 1 = tutti i jar in NIAGARA_DIST_DIR senza sottocartella per progetto.
#NIAGARA_DIST_FLAT=0

# Piattaforma dei container. Gli installer Tridium sono solo x86-64:
# su Apple Silicon girano in emulazione (piu' lenti, ma funzionano).
#NIAGARA_PLATFORM="linux/amd64"

# Glob per trovare l'installer dentro NIAGARA_INSTALLERS_DIR.
# Cambiali se i tuoi zip hanno nomi diversi (vedi README, sezione Installer).
#NIAGARA_N5_INSTALLER_GLOB="Niagara_5_Debian-%VERSION%*.zip"
#NIAGARA_N4_INSTALLER_GLOB="*N4*Linux_x64-%VERSION%*.zip"

# Brand Tridium: compare nei path delle "home" Niagara.
# N5 usa il brand minuscolo (/etc/niagara/<brand>/config/<ver>),
# N4 quello del distributore (es. TridiumEMEA, Tridium, Honeywell...).
#NIAGARA_N5_BRAND="tridium"
#NIAGARA_N4_BRAND="TridiumEMEA"

# Sorgenti dei JDK completi affiancati (vedi README, sezione Perche' due JDK).
#JDK_URL_N5="https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jdk/hotspot/normal/eclipse"
#JDK_URL_N4="https://api.adoptium.net/v3/binary/latest/8/ga/linux/x64/jdk/hotspot/normal/eclipse"

# Nome del volume Docker con la cache Gradle (uno per major version).
#NIAGARA_GRADLE_CACHE_PREFIX="niagara-gradle-cache"
