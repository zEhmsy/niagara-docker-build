# syntax=docker/dockerfile:1.7
#
# Immagine di BUILD per moduli Niagara 5 (non di runtime).
#
# Contiene: JDK di Niagara, repo m2 con i plugin Gradle Tridium, moduli Niagara
# per la compilazione. NON contiene: JxBrowser (UI Workbench), javadoc, licenze,
# chiavi di firma.
#
# LICENZA: l'immagine include binari Tridium. Uso interno soltanto: non
# pubblicarla su registry pubblici (Docker Hub, GHCR public).
#
# Il .deb pretende Ubuntu 24.04/26.04 + systemd attivo nel preinst, quindi
# `dpkg -i` non funziona in un container. Estraiamo direttamente il payload:
# per compilare non servono ne' systemd ne' l'utente `niagara`.

ARG NIAGARA_VERSION=5.0.0.12

# ---------------------------------------------------------------------------
# Stage 1 - estrazione del payload dal .deb
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS extract
ARG NIAGARA_VERSION
ARG NIAGARA_BRAND=tridium
ARG DEB_ZIP

RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip \
 && rm -rf /var/lib/apt/lists/*

# Il context e' la cartella degli installer (vedi Dockerfile.n5.dockerignore).
# Lo zip resta fuori dai layer: viene montato, non copiato.
RUN --mount=type=bind,target=/ctx \
    set -eu; \
    mkdir -p /rootfs /tmp/deb; \
    unzip -p "/ctx/${DEB_ZIP}" "niagara-${NIAGARA_VERSION}_amd64.deb" > /tmp/deb/n.deb; \
    dpkg-deb --fsys-tarfile /tmp/deb/n.deb \
      | tar -x -C /rootfs \
            --exclude="./opt/Niagara/${NIAGARA_VERSION}/JxBrowser" \
            --exclude="./opt/Niagara/${NIAGARA_VERSION}/javadoc" \
            --exclude="./opt/Niagara/${NIAGARA_VERSION}/icons" \
            --exclude="./usr/share/applications"; \
    rm -rf /tmp/deb; \
    test -x "/rootfs/opt/Niagara/${NIAGARA_VERSION}/jre/bin/javac"; \
    test -d "/rootfs/opt/Niagara/${NIAGARA_VERSION}/etc/m2/repository"; \
    test -d "/rootfs/etc/niagara/${NIAGARA_BRAND}/config/${NIAGARA_VERSION}/modules"

# ---------------------------------------------------------------------------
# Stage 1b - JDK completo
#
# Il JDK incluso in Niagara per Linux e' trimmato con jlink: ha `javac` ma NON
# il modulo `jdk.jartool`, quindi mancano `jar` e `jarsigner`, che i plugin
# Tridium (n-module, sign) invocano come eseguibili da PATH.
# Serve quindi un JDK completo della STESSA major version di quello Niagara.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS jdk
ARG JDK_URL=https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jdk/hotspot/normal/eclipse
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    mkdir -p /opt/jdk-full; \
    curl -fsSL "${JDK_URL}" | tar -xz -C /opt/jdk-full --strip-components=1; \
    /opt/jdk-full/bin/jar --version; \
    /opt/jdk-full/bin/jarsigner -help >/dev/null; \
    /opt/jdk-full/bin/javac -version

# ---------------------------------------------------------------------------
# Stage 2 - immagine finale
# ---------------------------------------------------------------------------
FROM ubuntu:24.04
ARG NIAGARA_VERSION
ARG NIAGARA_BRAND=tridium
ARG NIAGARA_USER_HOME_SUBPATH=Niagara/tridium/5.0
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates unzip zip git \
 && rm -rf /var/lib/apt/lists/*

# ubuntu:24.04 occupa gia' uid 1000 con l'utente `ubuntu`: lo rimuoviamo per
# poter allineare `builder` all'uid dell'host (i file scritti nel bind mount
# restano di proprieta' dell'utente host).
RUN userdel -r ubuntu 2>/dev/null || true; \
    groupadd -g "${BUILDER_GID}" builder 2>/dev/null || true; \
    useradd -m -u "${BUILDER_UID}" -g "${BUILDER_GID}" -s /bin/bash builder

# Il .deb installa tutto come uid 5011 (`niagara`) con permessi drwxr-x---:
# senza --chown l'utente di build non riesce nemmeno a leggere il JDK.
COPY --from=extract --chown=${BUILDER_UID}:${BUILDER_GID} /rootfs/opt/Niagara /opt/Niagara
COPY --from=extract --chown=${BUILDER_UID}:${BUILDER_GID} /rootfs/etc/niagara /etc/niagara
COPY --from=jdk /opt/jdk-full /opt/jdk-full

ENV NIAGARA_VERSION=${NIAGARA_VERSION} \
    NIAGARA_HOME=/opt/Niagara/${NIAGARA_VERSION} \
    NIAGARA_CONFIG_HOME=/etc/niagara/${NIAGARA_BRAND}/config/${NIAGARA_VERSION} \
    NIAGARA_USER_HOME=/home/builder/${NIAGARA_USER_HOME_SUBPATH} \
    JAVA_HOME=/opt/Niagara/${NIAGARA_VERSION}/jre \
    GRADLE_PLUGIN_HOME=/opt/Niagara/${NIAGARA_VERSION}/etc/m2/repository \
    GRADLE_USER_HOME=/home/builder/.gradle

# JAVA_HOME resta il JDK di Niagara: e' l'unico che contiene i moduli JavaFX
# richiesti dalle dipendenze Workbench (bajaui, gx, workbench).
# /opt/jdk-full/bin viene DOPO nel PATH: serve solo a fornire `jar` e
# `jarsigner`, che sono launcher autonomi (risolvono la propria home dal path
# del binario, non da JAVA_HOME).
ENV PATH=${JAVA_HOME}/bin:/opt/jdk-full/bin:${PATH}

# niagara_user_home: qui il plugin `sign` cerca il profilo di firma.
# Va montato dall'host (vedi nbuild.sh) - nell'immagine c'e' solo la dir vuota.
# uid/gid numerici: il gid dell'host puo' coincidere con un gruppo di sistema
# gia' esistente (su macOS gid 20 = `dialout` in Ubuntu), quindi il gruppo
# `builder` puo' non essere stato creato.
RUN mkdir -p "${NIAGARA_USER_HOME}" "${GRADLE_USER_HOME}" \
 && chown -R "${BUILDER_UID}:${BUILDER_GID}" /home/builder

# Entrypoint inline: il build context e' la cartella degli installer, quindi non
# possiamo fare COPY di file dal repo.
RUN <<'EOF' bash -eu
cat > /usr/local/bin/entrypoint.sh <<'SCRIPT'
#!/usr/bin/env bash
# Esegue gradlew nel progetto montato su /work forzando i tre "home" Niagara
# via -P, cosi' i gradle.properties con i path Windows restano intoccati.
set -euo pipefail

# `shell` apre una bash invece di buildare: deve venire PRIMA del check su
# gradlew, altrimenti non si puo' ispezionare l'immagine senza montare un progetto.
if [ "${1:-}" = "shell" ]; then
  shift
  exec bash "$@"
fi

if [ ! -x ./gradlew ]; then
  echo "ERRORE: nessun ./gradlew in $(pwd). Monta la root del progetto su /work." >&2
  exit 2
fi

TASKS=("$@")
[ ${#TASKS[@]} -eq 0 ] && TASKS=(build)

exec ./gradlew \
  "-Pniagara_home=${NIAGARA_HOME}" \
  "-Pniagara_user_home=${NIAGARA_USER_HOME}" \
  "-Pniagara_config_home=${NIAGARA_CONFIG_HOME}" \
  "-PgradlePluginHome=${GRADLE_PLUGIN_HOME}" \
  "-Porg.gradle.java.installations.paths=${JAVA_HOME}" \
  --console=plain \
  "${TASKS[@]}"
SCRIPT
chmod 755 /usr/local/bin/entrypoint.sh
EOF

USER ${BUILDER_UID}:${BUILDER_GID}
WORKDIR /work

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["build"]
