# syntax=docker/dockerfile:1.7
#
# BUILD image for Niagara 5 modules (not a runtime image).
#
# It contains: the Niagara JDK, an m2 repo with the Tridium Gradle plugins and
# the Niagara modules needed to compile. It does NOT contain: JxBrowser
# (Workbench UI), javadoc, licenses or signing keys.
#
# LICENSING: the image embeds Tridium binaries. Internal use only: do not push
# it to public registries (Docker Hub, public GHCR).
#
# The .deb requires Ubuntu 24.04/26.04 with a live systemd in its preinst, so
# `dpkg -i` does not work inside a container. We extract the payload directly:
# compiling needs neither systemd nor the `niagara` user.

ARG NIAGARA_VERSION=5.0.0.12

# ---------------------------------------------------------------------------
# Stage 1 - extract the payload from the .deb
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS extract
ARG NIAGARA_VERSION
ARG NIAGARA_BRAND=tridium
ARG DEB_ZIP

RUN apt-get update \
 && apt-get install -y --no-install-recommends unzip \
 && rm -rf /var/lib/apt/lists/*

# The context is the installer folder (see Dockerfile.n5.dockerignore).
# The zip stays out of the layers: it is mounted, not copied.
RUN --mount=type=bind,target=/ctx \
    set -eu; \
    mkdir -p /rootfs /tmp/deb; \
    unzip -p "/ctx/${DEB_ZIP}" "niagara-${NIAGARA_VERSION}_amd64.deb" > /tmp/deb/n.deb; \
    dpkg-deb --fsys-tarfile /tmp/deb/n.deb \
      | tar -x -C /rootfs \
            --exclude="./opt/Niagara/${NIAGARA_VERSION}/JxBrowser" \
            --exclude="./opt/Niagara/${NIAGARA_VERSION}/javadoc" \
            --exclude="./opt/Niagara/${NIAGARA_VERSION}/icons" \
            --exclude="./usr/share/applications"; \
    rm -rf /tmp/deb; \
    test -x "/rootfs/opt/Niagara/${NIAGARA_VERSION}/jre/bin/javac"; \
    test -d "/rootfs/opt/Niagara/${NIAGARA_VERSION}/etc/m2/repository"; \
    test -d "/rootfs/etc/niagara/${NIAGARA_BRAND}/config/${NIAGARA_VERSION}/modules"

# ---------------------------------------------------------------------------
# Stage 1b - full JDK
#
# The JDK shipped with Niagara for Linux is jlink-trimmed: it has `javac` but
# NOT the `jdk.jartool` module, so `jar` and `jarsigner` are missing — and the
# Tridium plugins (n-module, sign) invoke those as executables from PATH.
# Hence a full JDK of the SAME major version as the Niagara one.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS jdk
ARG JDK_URL=https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jdk/hotspot/normal/eclipse
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    mkdir -p /opt/jdk-full; \
    curl -fsSL "${JDK_URL}" | tar -xz -C /opt/jdk-full --strip-components=1; \
    /opt/jdk-full/bin/jar --version; \
    /opt/jdk-full/bin/jarsigner -help >/dev/null; \
    /opt/jdk-full/bin/javac -version

# ---------------------------------------------------------------------------
# Stage 2 - final image
# ---------------------------------------------------------------------------
FROM ubuntu:24.04
ARG NIAGARA_VERSION
ARG NIAGARA_BRAND=tridium
ARG NIAGARA_USER_HOME_SUBPATH=Niagara/tridium/5.0
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates unzip zip git \
 && rm -rf /var/lib/apt/lists/*

# ubuntu:24.04 already uses uid 1000 for the `ubuntu` user: we drop it so that
# `builder` can match the host uid (files written through the bind mount stay
# owned by the host user).
RUN userdel -r ubuntu 2>/dev/null || true; \
    groupadd -g "${BUILDER_GID}" builder 2>/dev/null || true; \
    useradd -m -u "${BUILDER_UID}" -g "${BUILDER_GID}" -s /bin/bash builder

# The .deb installs everything as uid 5011 (`niagara`) with drwxr-x--- perms:
# without --chown the build user cannot even read the JDK.
COPY --from=extract --chown=${BUILDER_UID}:${BUILDER_GID} /rootfs/opt/Niagara /opt/Niagara
COPY --from=extract --chown=${BUILDER_UID}:${BUILDER_GID} /rootfs/etc/niagara /etc/niagara
COPY --from=jdk /opt/jdk-full /opt/jdk-full

ENV NIAGARA_VERSION=${NIAGARA_VERSION} \
    NIAGARA_HOME=/opt/Niagara/${NIAGARA_VERSION} \
    NIAGARA_CONFIG_HOME=/etc/niagara/${NIAGARA_BRAND}/config/${NIAGARA_VERSION} \
    NIAGARA_USER_HOME=/home/builder/${NIAGARA_USER_HOME_SUBPATH} \
    JAVA_HOME=/opt/Niagara/${NIAGARA_VERSION}/jre \
    GRADLE_PLUGIN_HOME=/opt/Niagara/${NIAGARA_VERSION}/etc/m2/repository \
    GRADLE_USER_HOME=/home/builder/.gradle

# JAVA_HOME stays on the Niagara JDK: it is the only one carrying the JavaFX
# modules required by the Workbench dependencies (bajaui, gx, workbench).
# /opt/jdk-full/bin comes LATER in PATH: it only provides `jar` and
# `jarsigner`, which are self-contained launchers (they resolve their own home
# from the binary path, not from JAVA_HOME).
ENV PATH=${JAVA_HOME}/bin:/opt/jdk-full/bin:${PATH}

# niagara_user_home: this is where the `sign` plugin looks for the signing
# profile. It must be mounted from the host (see nbuild.sh) — the image only
# ships the empty dir.
# Numeric uid/gid: the host gid may clash with an existing system group (on
# macOS gid 20 = `dialout` on Ubuntu), so the `builder` group may not exist.
RUN mkdir -p "${NIAGARA_USER_HOME}" "${GRADLE_USER_HOME}" \
 && chown -R "${BUILDER_UID}:${BUILDER_GID}" /home/builder

# Inline entrypoint: the build context is the installer folder, so we cannot
# COPY files from the repo.
RUN <<'EOF' bash -eu
cat > /usr/local/bin/entrypoint.sh <<'SCRIPT'
#!/usr/bin/env bash
# Runs gradlew on the project mounted at /work, forcing the three Niagara
# "homes" via -P so that gradle.properties files with Windows paths stay as is.
set -euo pipefail

# `shell` opens a bash instead of building: it must come BEFORE the gradlew
# check, otherwise the image cannot be inspected without mounting a project.
if [ "${1:-}" = "shell" ]; then
  shift
  exec bash "$@"
fi

if [ ! -x ./gradlew ]; then
  echo "ERROR: no ./gradlew in $(pwd). Mount the project root at /work." >&2
  exit 2
fi

TASKS=("$@")
[ ${#TASKS[@]} -eq 0 ] && TASKS=(build)

exec ./gradlew \
  "-Pniagara_home=${NIAGARA_HOME}" \
  "-Pniagara_user_home=${NIAGARA_USER_HOME}" \
  "-Pniagara_config_home=${NIAGARA_CONFIG_HOME}" \
  "-PgradlePluginHome=${GRADLE_PLUGIN_HOME}" \
  "-Porg.gradle.java.installations.paths=${JAVA_HOME}" \
  --console=plain \
  "${TASKS[@]}"
SCRIPT
chmod 755 /usr/local/bin/entrypoint.sh
EOF

USER ${BUILDER_UID}:${BUILDER_GID}
WORKDIR /work

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["build"]
